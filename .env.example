# ==============================================================================
# Multi-Document Conversational RAG Configuration
# ==============================================================================

# LLM Provider: 'gemini' (Recommended / Free tier), 'groq', or 'mock' (offline fallback)
LLM_PROVIDER=gemini

# Primary API Keys (Provide at least one)
GEMINI_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# LLM Generation Parameters
LLM_MODEL=gemini-1.5-flash
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=1024

# Embedding Model (HuggingFace local model - runs on CPU, zero API cost)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# RAG & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4
SIMILARITY_SCORE_THRESHOLD=0.30

# Storage Paths
VECTOR_STORE_DIR=data/faiss_index
UPLOAD_DIR=data/uploaded_docs
SAMPLE_DOCS_DIR=data/sample_docs

# API Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
